{
    "description": "Project Forge Studio v1 - Workflow profissional para sprites pixel art consistentes. Batch de 4 variacoes, prompt mestre + negative fixo. Otimizado para Colab T4 e RunPod 48GB.",
    "4": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": {
            "ckpt_name": "__CHECKPOINT__"
        }
    },
    "5": {
        "class_type": "EmptyLatentImage",
        "inputs": {
            "width": "__WIDTH__",
            "height": "__HEIGHT__",
            "batch_size": "__BATCH__"
        }
    },
    "6": {
        "class_type": "CLIPTextEncode",
        "inputs": {
            "text": "__PROMPT__",
            "clip": ["4", 1]
        }
    },
    "7": {
        "class_type": "CLIPTextEncode",
        "inputs": {
            "text": "__NEGATIVE__",
            "clip": ["4", 1]
        }
    },
    "3": {
        "class_type": "KSampler",
        "inputs": {
            "model": ["4", 0],
            "positive": ["6", 0],
            "negative": ["7", 0],
            "latent_image": ["5", 0],
            "seed": "__SEED__",
            "steps": "__STEPS__",
            "cfg": "__CFG__",
            "sampler_name": "__SAMPLER__",
            "scheduler": "__SCHEDULER__",
            "denoise": 1.0
        }
    },
    "8": {
        "class_type": "VAEDecode",
        "inputs": {
            "samples": ["3", 0],
            "vae": ["4", 2]
        }
    },
    "9": {
        "class_type": "SaveImage",
        "inputs": {
            "filename_prefix": "__FILENAME_PREFIX__",
            "images": ["8", 0]
        }
    }
}
